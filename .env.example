# TAPS Environment Variables Template
# Copy this file to .env and update with your actual values

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================

# PostgreSQL Database Password
# IMPORTANT: Change this in production!
DB_PASSWORD=taps_password_change_in_production

# Database Connection Settings
DATABASE_URL=postgresql+asyncpg://taps_user:${DB_PASSWORD}@postgres:5432/taps

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Connection URL
REDIS_URL=redis://redis:6379/0

# Redis Connection Pool Settings
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug Mode (true for development, false for production)
DEBUG=true

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# AUTHENTICATION & SECURITY (for future use)
# =============================================================================

# JWT Secret Key (generate a secure random string for production)
# Example: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here-change-in-production

# JWT Algorithm
JWT_ALGORITHM=HS256

# Access Token Expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed Origins (comma-separated list)
# For development: http://localhost:3000
# For production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# PGADMIN CONFIGURATION (Optional)
# =============================================================================

# pgAdmin Default Email
PGADMIN_EMAIL=admin@taps.local

# pgAdmin Default Password
PGADMIN_PASSWORD=admin

# =============================================================================
# BACKEND SERVICE CONFIGURATION
# =============================================================================

# Backend Port
BACKEND_PORT=8000

# Backend Host
BACKEND_HOST=0.0.0.0

# =============================================================================
# FRONTEND CONFIGURATION (Next.js)
# =============================================================================

# Frontend API URL (backend service URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend WebSocket URL (for future real-time features)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Frontend Environment
NEXT_PUBLIC_ENVIRONMENT=development

# Enable/Disable Mock Data (true for development, false for production)
NEXT_PUBLIC_USE_MOCK_DATA=false

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. Never commit the actual .env file to version control
# 2. Always use strong passwords in production
# 3. Generate secure random strings for JWT_SECRET_KEY
# 4. Update ALLOWED_ORIGINS to match your production domain
# 5. Set DEBUG=false in production
# 6. Use environment-specific values for staging and production
# 
# =============================================================================
