# TAPS Docker Compose .gitignore

# Environment variables
.env
.env.local
.env.*.local

# Docker volumes data (local development)
postgres_data/
redis_data/
pgadmin_data/

# Database backups
*.sql
*.sql.gz
*.rdb
backup_*/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
tmp/
temp/

# slingshot
.slingshot
/venv
.pytest_cache
__pycache__/
